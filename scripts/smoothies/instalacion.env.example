# Rellena con la configuración de la instancia local dedicada a smoothies.
SMOOTHIES_API_URL=http://127.0.0.1:58000
SMOOTHIES_DATABASE_URL=postgresql://postgres:CAMBIA_ESTO@127.0.0.1:55432/postgres
SMOOTHIES_ANON_KEY=
SMOOTHIES_SERVICE_KEY=
SMOOTHIES_COMPOSE_FILE="C:\POS-Supabase\docker-compose.yml"
SMOOTHIES_ADMIN_PASSWORD=

# Opcionales. Si se dejan vacías, el instalador usa carpetas en %LOCALAPPDATA%\POS Smoothies.
SMOOTHIES_PRINT_DIR=
SMOOTHIES_BACKUP_DIR=
SMOOTHIES_BACKUP_KEY_FILE=

# El instalador -LanAddress genera estos valores y el certificado público para
# aceptar la confianza en PC/iPad. Conservar vacíos mantiene una caja solo local.
SMOOTHIES_LAN_ORIGIN=
SMOOTHIES_LAN_CERT_FILE=
SMOOTHIES_LAN_KEY_FILE=
